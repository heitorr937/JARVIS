
{
    "manifest_version": 3,
    "name": "JARVIS - Navegação local",
    "version": "1.0.0",
    "description": "Conecta o JARVIS ao navegador Chrome por uma ponte local.",
    "permissions": [
        "activeTab",
        "scripting",
        "tabs"
    ],
    "host_permissions": [
        "http://127.0.0.1:8765/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "JARVIS"
    }
}
