{
  "manifest_version": 3,
  "name": "JARVIS - Navegação local",
  "version": "1.1.1",
  "description": "Conecta o JARVIS ao Chrome com ativação global em todas as abas.",
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JARVIS"
  }
}
